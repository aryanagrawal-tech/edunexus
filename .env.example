# EduNexus AI — Environment Variables Configuration
# Copy this file to .env and fill in your Supabase credentials.

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
FLASK_SECRET_KEY=replace_with_a_strong_secret_key

# Initial Admin & Faculty Credentials (Stored as password hashes in Supabase)
ADMIN_EMAIL=admin@edunexus.com
ADMIN_PASSWORD=your_secure_admin_password_here
FACULTY_EMAIL=faculty@edunexus.com
FACULTY_PASSWORD=your_secure_faculty_password_here

# Supabase PostgreSQL Configuration
# Found in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Fallback Mode: if SUPABASE_URL or SUPABASE_KEY are empty or invalid,
# the backend gracefully falls back to read-only demo mode using mock_data.json.

# Google Gemini API Configuration (AI Study Assistant)
GEMINI_API_KEY=your_gemini_api_key_here
